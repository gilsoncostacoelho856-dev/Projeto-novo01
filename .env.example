# =====================================================================
# Configuracao do Supabase (opcional)
# ---------------------------------------------------------------------
# Sem estas variaveis o app roda em MODO DEMONSTRACAO, guardando os
# dados no proprio navegador (localStorage). Basta `npm run dev`.
#
# Para ligar o banco de verdade:
#   1. crie um projeto gratuito em https://supabase.com
#   2. rode o SQL de `supabase/schema.sql` no SQL Editor do projeto
#   3. copie este arquivo para `.env.local` e preencha os dois valores
#      (Project Settings -> API)
#
# ATENCAO: use apenas a chave "anon / publishable". A chave `service_role`
# NUNCA deve entrar em um arquivo NEXT_PUBLIC_* nem no navegador.
# =====================================================================

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui
